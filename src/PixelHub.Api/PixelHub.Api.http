# Carnet de tests PixelHub — cliquer sur « Send request » au-dessus de chaque bloc.
# Port : celui affiché par `dotnet run` (5199 via launchSettings.json),
# et aussi celui de l'API conteneurisée (docker compose --profile app up -d).
@host = http://localhost:5199

### Santé
GET {{host}}/

### Séance 1 — PostgreSQL
GET {{host}}/players
Accept: application/json

### Séance 1 — bonus : créer un joueur
POST {{host}}/players
Content-Type: application/json

{ "pseudo": "Pixel", "coins": 500 }

### Séance 2 — MongoDB : catalogue complet
GET {{host}}/games
Accept: application/json

### Séance 2 — filtrage par genre
GET {{host}}/games/genre/FPS
Accept: application/json

### Séance 2 — top 3
GET {{host}}/games/top/3
Accept: application/json

### Séance 2 — agrégation : note moyenne par genre
GET {{host}}/games/stats
Accept: application/json

### Séance 2.6 - catalogue avec cache Redis
# Répéter cette requête dans les 60 secondes pour utiliser la valeur en cache.
GET {{host}}/games
Accept: application/json

### Redis - ajouter des points au classement
POST {{host}}/leaderboard/Pixel/points/125.5

### Redis - meilleurs scores
GET {{host}}/leaderboard/top/10
Accept: application/json

### Redis - rang d'un joueur
GET {{host}}/leaderboard/rank/Pixel
Accept: application/json

### Redis - mesurer le temps
GET {{host}}/games/timed
Accept: application/json